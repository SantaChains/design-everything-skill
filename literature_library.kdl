meta {
    version "1.0"
    name "文学素材库配置"
    description "公有领域文学作品素材库，用于提取动作设计、姿势设计、人物外貌设计等文本素材"
    updated "2026-04-13"
    copyright "所有素材均来自公有领域作品，无版权限制"
}

sources {
    international {
        project_gutenberg {
            url "https://dev.gutenberg.org/"
            description "全球最大的公有领域英文电子书库，超过75,000部经典著作"
            languages "英语、法语、德语、西班牙语、葡萄牙语等"
            features "免费下载、多种格式（epub、Kindle）、在线阅读"
            categories "文学、哲学、历史、科学、宗教"
        }
        
        internet_archive {
            url "https://www.archive.org"
            description "互联网档案馆，数百万免费书籍（公有领域和绝版书）"
            features "借阅功能、高清扫描件、多格式支持"
        }
        
        google_books {
            url "https://books.google.com"
            description "Google 图书，大量公有领域作品可免费阅读"
            features "全文检索、在线阅读、部分下载"
        }
        
        libriVox {
            url "https://librivox.org/"
            description "免费公有领域有声读物，志愿者朗读"
            features "音频格式、多语言、与Project Gutenberg文本对应"
        }
    }
    
    chinese {
        shuge {
            url "https://www.shuge.org"
            description "书格 - 开放的免费线上数字图书馆，专注古籍善本"
            features "高清古籍影像、PDF下载、公共版权领域"
            categories "艺术、历史、文学、哲学、宗教"
        }
        
        national_library {
            url "https://guji.nlc.cn/"
            description "中华古籍智慧化服务平台，国家图书馆官方"
            features "1万余种古籍资源、免费开放、免登录访问"
            categories "善本、普通古籍、敦煌文献"
        }
        
        guoxue_dashi {
            url "http://www.guoxuedashi.com/"
            description "国学大师 - 集成大型丛书电子版"
            features "全文检索、原文注释、白话翻译"
            collections "四库全书、永乐大典、古今图书集成"
        }
        
        han_dian {
            url "https://gj.zdic.net/"
            description "汉典古籍 - 经史子集四部古籍"
            features "全文检索、在线阅读"
            examples "论语、史记、资治通鉴"
        }
        
        ctext {
            url "https://ctext.org/zh"
            description "中国哲学书电子化计划"
            features "中英文双语检索、交叉比对版本"
            collections "四库全书、道藏、佛经"
        }
        
        cadal {
            url "https://cadal.edu.cn/index/home"
            description "大学数字图书馆国际合作计划"
            features "250万册数字资源、在线浏览、图书借阅模式"
            categories "古籍、外文、民国、特藏资源"
        }
    }
}

categories {
    western_classics {
        name "西方经典文学"
        period "古希腊罗马至20世纪初"
        types "小说、诗歌、戏剧、散文"
        examples {
            shakespeare "莎士比亚戏剧集 - 人物对话、情感表达、戏剧冲突"
            dickens "狄更斯小说 - 人物描写、社会场景、情感刻画"
            tolstoy "托尔斯泰作品 - 宏大叙事、心理描写、人物塑造"
            austen "简·奥斯汀 - 社交场景、人物互动、对话艺术"
            hugo "雨果作品 - 浪漫主义、情感张力、人物形象"
        }
    }
    
    chinese_classics {
        name "中国古典文学"
        period "先秦至清代"
        types "诗词、散文、小说、戏曲"
        examples {
            four_masterpieces "四大名著 - 人物塑造、情节设计、场景描写"
            poetry "唐诗宋词 - 意象表达、情感抒发、景物描写"
            classical_prose "古文观止 - 论辩艺术、叙事技巧、人物刻画"
            drama "元曲明清戏曲 - 对话艺术、人物性格、冲突设计"
        }
    }
    
    philosophy {
        name "哲学经典"
        period "古代至近代"
        types "东西方哲学著作"
        examples {
            western_philosophy "柏拉图、亚里士多德、康德等 - 思辨逻辑、论证方法"
            chinese_philosophy "论语、道德经、庄子等 - 哲理表达、寓言故事"
            buddhist_texts "佛经 - 意象丰富、比喻生动、叙事宏大"
        }
    }
    
    history {
        name "历史著作"
        period "古代至近代"
        types "史书、传记、回忆录"
        examples {
            records "史记、汉书等 - 人物传记、历史叙事、场景再现"
            western_history "希罗多德、修昔底德等 - 历史叙述、人物刻画"
        }
    }
}

extraction_guidelines {
    action_design {
        description "从文学作品中提取动作设计素材"
        sources "戏剧、小说中的动作描写"
        elements "肢体动作、表情变化、姿态转换、动作序列"
        examples {
            shakespeare_action "莎士比亚戏剧中的舞台指示和动作描写"
            chinese_action "中国古典小说中的武打场面和动作描写"
        }
    }
    
    pose_design {
        description "从文学作品中提取姿势设计素材"
        sources "绘画描述、雕塑描写、人物姿态"
        elements "站姿、坐姿、卧姿、动态姿势、静态姿势"
        examples {
            classical_pose "古典文学中的人物姿态描写"
            artistic_pose "艺术作品中的姿势描述"
        }
    }
    
    character_appearance {
        description "从文学作品中提取人物外貌设计素材"
        sources "小说、戏剧、诗歌中的人物描写"
        elements "面部特征、身材体型、服饰装扮、气质神态"
        examples {
            western_characters "西方文学中的人物外貌描写"
            chinese_characters "中国古典文学中的人物形象描写"
        }
    }
    
    emotional_expression {
        description "从文学作品中提取情感表达素材"
        sources "所有文学类型"
        elements "喜怒哀乐、复杂情感、情感转换、情感张力"
        examples {
            poetry_emotion "诗歌中的情感抒发"
            novel_emotion "小说中的情感描写"
        }
    }
}

usage_rules {
    copyright {
        rule "所有素材必须来自公有领域作品"
        definition "作者去世超过50年（中国）或70年（欧美）的作品"
        verification "使用前确认作品的版权状态"
        note "现代点校版或影印版可能受版权保护"
    }
    
    attribution {
        rule "使用素材时标注来源"
        format "作品名称 + 作者 + 来源链接"
        example "《红楼梦》曹雪芹 - https://www.shuge.org"
    }
    
    quality_control {
        rule "优先选择权威版本和高质量数字化版本"
        sources "国家图书馆、知名学术机构、专业数据库"
        avoid "非正规网站、内容缺失、错漏百出的版本"
    }
    
    extraction_method {
        rule "提取素材时保持原文完整性"
        method "引用原文片段 + 标注出处 + 提炼要点"
        format "原文引用 + 素材类型 + 应用场景"
    }
}

recommended_works {
    action_rich {
        title "水浒传"
        author "施耐庵"
        reason "武打场面丰富，动作描写生动"
        source "https://www.shuge.org"
    }
    
    character_rich {
        title "红楼梦"
        author "曹雪芹"
        reason "人物形象鲜明，外貌描写细腻"
        source "https://www.shuge.org"
    }
    
    emotion_rich {
        title "莎士比亚戏剧集"
        author "莎士比亚"
        reason "情感表达丰富，人物性格鲜明"
        source "https://dev.gutenberg.org"
    }
    
    philosophy_rich {
        title "庄子"
        author "庄子"
        reason "寓言故事生动，哲理表达形象"
        source "https://ctext.org/zh"
    }
}

integration_with_skill_router {
    priority "P2"
    timeline "2周内完成基础配置"
    dependencies "KDL配置系统"
    usage "Skill Router 根据用户需求自动推荐相关文学素材"
    example {
        user_request "设计一个古代侠客的动作"
        router_action "从《水浒传》《三国演义》中提取武打动作素材"
        output "动作描述 + 原文引用 + 应用建议"
    }
}
